{
  "name": "opencode-fastdraw",
  "version": "1.0.0",
  "description": "Quick-draw model switching for opencode agents — bind models to roles/agents from the TUI, snapshot them as presets, preview, share, and hot-swap instantly",
  "type": "module",
  "exports": {
    "./server": "./server.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "server.ts",
    "tui.ts",
    "roles.ts",
    "origins.ts",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "esbuild server.ts --format=esm --platform=node --bundle --outfile=test/.build/server.mjs --log-level=error && esbuild origins.ts --format=esm --platform=node --bundle --outfile=test/.build/origins.mjs --log-level=error",
    "test": "node test/preset.test.mjs && node test/preset-split.test.mjs && node test/origins.test.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "model-switching",
    "agents",
    "presets",
    "oh-my-openagent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-GITHUB-USER/opencode-fastdraw.git"
  },
  "homepage": "https://github.com/YOUR-GITHUB-USER/opencode-fastdraw#readme",
  "bugs": "https://github.com/YOUR-GITHUB-USER/opencode-fastdraw/issues",
  "engines": {
    "opencode": ">=1.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "esbuild": "^0.25.0"
  }
}
